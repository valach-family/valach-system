    "text": {
     "title": "Vállalkozás hozzáadása",
     "lead": "Öt lépés. A mentést te végzed el.",
     "s1": {
      "title": "A fiók fajtája",
      "body": "Vállalkozás (adóazonosítóval) vagy közös fiók (adóazonosító nélkül). A céges adatlap csak a vállalkozásnál jelenik meg."
     },
     "s2": {
      "title": "A fiók neve",
      "body": "Ez látszik majd a fiókválasztóban és a képernyők fejlécében."
     },
     "s3": {
      "title": "A nyilvántartás országa",
      "body": "Ez azt mondja meg, milyen alakú azonosítót tartunk nyilván. Nem választ adózási rendet és nem ellenőrzi a céget hatósági nyilvántartásban."
     },
     "s4": {
      "title": "Az adóazonosító",
      "body": "Ez önbevallott adat: az alakját ellenőrizzük, a valódiságát nem. Megadása nem igazolja más vállalkozás képviseletét."
     },
     "s5": {
      "title": "A létrehozás",
      "body": "Nyomd meg az „Új fiók hozzáadása” gombot. Ez a lépés csak tényleges létrehozás után halad tovább."
     }
