    ],
    "text": {
     "title": "Egy kiadott meghívás visszavonása — és ami utána jön",
     "lead": "Végigviszed mind a két oldalról: visszavonod a meghívást, a címzett nézetében látod, hogy a régi hivatkozás már nem jó, majd új meghívást adsz, amit ő elfogad.",
     "s1": {
      "title": "Nyisd meg a Felhasználókat",
      "body": "A Beállítások csoportban, fiókkezelői jogosultsággal."
     },
     "s2": {
      "title": "Váltsd át az „Elfogadásra vár” fülre",
      "body": "Itt látszik, melyik meghívás vár elfogadásra, melyiket fogadták el, melyik járt le, és melyiket vonták vissza."
     },
     "s3": {
      "title": "Keresd meg a függő meghívást",
      "body": "Béla sora „Elfogadásra vár” állapotban áll. A sor végén van a visszavonás gombja."
     },
     "s4": {
      "title": "Vond vissza a meghívást",
      "body": "A sor „Meghívás visszavonása” gombja, majd a megerősítés. Ez a lépés csak tényleges visszavonás után halad tovább."
     },
     "s5": {
      "title": "Nézd meg a megváltozott állapotot",
      "body": "A sor most „Visszavonva”, és a művelet oszlopa üres: ugyanazt a meghívást másodszor nem lehet visszavonni."
     },
     "s6": {
      "title": "Válts át Béla nézetére",
      "body": "A próbafelület sávjában a „Váltás Béla nézetére” gomb. Ez valódi ki- és belépés: innentől az ő munkamenetében vagy. Ha panel van nyitva, előbb zárd be — a sáv csak akkor érhető el."
     },
     "s7": {
      "title": "Nyisd meg a próbaüzeneteket",
      "body": "Itt állnak a próbafelület levelei. A korábban kiküldött meghívó is köztük van."
     },
     "s8": {
      "title": "Nyisd meg a korábbi meghívó hivatkozását",
      "body": "Ez az a hivatkozás, amit Béla korábban megkapott. Kattints rá: a meghívó képernyője nyílik meg."
     },
     "s9": {
      "title": "A régi meghívó megnyitva",
      "body": "A képernyő kimondja: ezt a meghívást visszavonták, ezért nem fogadható el. Elfogadás gomb sincs — a hivatkozás elhalt."
     },
     "s10": {
      "title": "Válts vissza Anna nézetére",
      "body": "A fiókkezelőnek új meghívást kell kiadnia — a régi hivatkozás már nem éleszthető fel."
     },
     "s11": {
      "title": "Nyisd meg újra a Felhasználókat",
      "body": "A váltás után az áttekintésen állsz. A meghívás a Felhasználók képernyőről indul."
     },
     "s12": {
      "title": "Nyisd meg a meghívás űrlapját",
      "body": "A „Felhasználó meghívása” gomb a képernyő tetején."
     },
     "s13": {
      "title": "Adj ki új meghívást Bélának",
      "body": "A „Felhasználó meghívása” gomb, majd a cím és az adatkör megadása után az elküldés. Ez a lépés csak tényleges elküldés után halad tovább."
     },
     "s14": {
      "title": "Válts át újra Béla nézetére",
      "body": "Most már az új meghívó várja. A tagságot továbbra is az ő elfogadása hozza létre."
     },
     "s15": {
      "title": "Nyisd meg újra a próbaüzeneteket",
      "body": "Az új meghívó levele is ide érkezett."
     },
     "s16": {
      "title": "Nyisd meg az új meghívó hivatkozását",
      "body": "A legfrissebb levél hivatkozása. Ez már az új meghívásra szól."
     },
     "s17": {
      "title": "Fogadd el az új meghívást",
      "body": "Béla saját műveletével. Az útmutató ezt soha nem végzi el helyette."
     },
     "s18": {
      "title": "Nézd meg az eredményt",
      "body": "A fiókváltóban ott a cég: Béla mostantól tag. A régi, visszavont meghívó ettől nem éledt fel — ez egy új meghívás eredménye."
     }
    }
   },
