    ],
    "text": {
     "title": "Körbevezetés a felületen",
     "lead": "Öt lépés: mi hol van. Semmit nem mentünk el közben.",
     "s1": {
      "title": "A fiókválasztó",
      "body": "Itt látod, melyik fiók van megnyitva, és itt tudsz másikra váltani. A személyes fiókod és a vállalkozásaid egy listán állnak."
     },
     "s2": {
      "title": "A menü",
      "body": "A bal oldali menü csoportokba rendezi a képernyőket. Csak az látszik, amit használni is tudsz."
     },
     "s3": {
      "title": "A lapok",
      "body": "A megnyitott képernyők fülként itt sorakoznak. Ugyanaz a lap nem nyílik meg kétszer."
     },
     "s4": {
      "title": "A saját profil",
      "body": "A jobb felső menüben a saját adataid, a nyelv és a kijelentkezés."
     },
     "s5": {
      "title": "A Súgó",
      "body": "Innen nyílik a súgó: kérdezhetsz, leírást olvashatsz, kereshetsz a gyakori kérdésekben, vagy megnézheted az oldaltérképet."
     }
    }
