{
  "name": "valach-system",
  "version": "3.0.0-alpha",
  "private": true,
  "description": "Valach System (VS) — canonical implementation repository. A verzió CÍMKE a git-történetben, nem a repó neve.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "docs:html": "node tools/vs_doc_html.mjs --all",
    "v3ref:evidence": "node v3ref/run.mjs --json",
    "v3ref:mutate": "node v3ref/mutate.mjs",
    "v3ref:mutate:units": "node v3ref/mutate.mjs --units-auto",
    "v3ref:run": "node v3ref/run.mjs",
    "verify:artifact-naming": "node tools/vs_verify_artifact_naming.mjs",
    "verify:capability-witness": "node tools/vs_verify_capability_witness.mjs",
    "verify:decision-numbers": "node tools/vs_verify_decision_numbers.mjs",
    "verify:doc-html": "node tools/vs_verify_doc_html.mjs",
    "verify:external-checks": "node v3ref/external-checks/run-all.mjs",
    "proof:mny01-form": "node v3ref/external-checks/mny01_form_counterexample.mjs",
    "verify:kuka": "node tools/vs_verify_kuka.mjs",
    "verify:release-order": "node tools/vs_verify_release_order.mjs",
    "verify:sweep": "node tools/vs_verify_sweep.mjs",
    "verify:sweep-verdict": "node tools/vs_verify_sweep_verdict.mjs",
    "verify:unit-admission": "node tools/vs_verify_unit_admission.mjs",
    "verify:v3ref": "node v3ref/run.mjs && npm run --silent v3ref:mutate:units",
    "docs:norm-chain": "node tools/v3_norm_chain_package.mjs",
    "proof:norm-chain-package": "node tools/v3_norm_chain_package_proof.mjs",
    "verify:external-decisions": "node tools/vs_verify_external_decisions.mjs",
    "verify:grant-paths": "node tools/vs_verify_grant_paths.mjs"
  }
}
