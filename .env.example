# V3 — A KÖRNYEZETI VÁLTOZÓK NEVEI. ÉRTÉK IDE SOHA NEM KERÜL (operátori állandó).
#
# Ez a fájl a NÉVJEGYZÉK: megmondja, mit kell beállítani, és hol. A Railway-n ezek a
# szolgáltatás „Variables" lapján állnak, NEM ebben a fájlban és NEM a repóban.
#   Railway → valach-system → staging → app → Variables

# ── TÁROLÓ ────────────────────────────────────────────────────────────────────────────────────
# A staging SAJÁT PostgreSQL-ének reference változója — SOHA nem a V2-é és nem a Boardé.
# Railway-n: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# Melyik környezet ez: staging | production | demo | (üres = helyi fejlesztés).
# Telepített értéknél a szerver DATABASE_URL nélkül EL SEM INDUL (nincs néma SQLite-visszaesés),
# a fejlesztői felület alapból KI, a süti Secure, és a hozzáférés-védelem KÖTELEZŐ.
VS_APP_ENV=

# ── HOZZÁFÉRÉS-VÉDELEM (a teljes UI és API elé) ───────────────────────────────────────────────
VS_APP_ACCESS_USER=
VS_APP_ACCESS_PASSWORD=

# ── HÁLÓZAT ───────────────────────────────────────────────────────────────────────────────────
# A PORT-ot a Railway adja — NE állítsd be kézzel.
# Fordított proxy mögött 1: ettől olvassuk az X-Forwarded-For/Proto fejlécet.
VS_APP_TRUST_PROXY=
VS_APP_RATE_WINDOW_MS=
VS_APP_RATE_MAX=

# ── AI (R147: a kulcs helye MOSTANTÓL ez) ─────────────────────────────────────────────────────
# Railway → valach-system → staging → app → Variables
VS_AI_PROVIDER=
VS_AI_API_KEY=
VS_AI_BASE_URL=
VS_AI_MODEL=

# ── FEJLESZTŐI FELÜLET — telepített környezetben CSAK kifejezett 1 kapcsolja be ────────────────
# A fejlesztői levél-fogadó, az óra és a szereplőváltás nyílt interneten nem lehet bekapcsolva.
VS_APP_DEV=

# ── MIGRÁCIÓ ──────────────────────────────────────────────────────────────────────────────────
VS_MIGRATE_TIMEOUT_MS=
